rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isRestaurantOwner(restaurantId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/restaurants/$(restaurantId))
        && get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == request.auth.uid;
    }

    function isRestaurantAdmin(restaurantId) {
      return request.auth != null && (
        isRestaurantOwner(restaurantId)
        || (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && (
            get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.restaurantId == restaurantId
            || get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.cafeId == restaurantId
          )
        )
      );
    }

    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isRestaurantAdmin(restaurantId);

      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isRestaurantAdmin(restaurantId);

        match /items/{itemId} {
          allow read: if true;
          allow write: if isRestaurantAdmin(restaurantId);
        }
      }

      match /orders/{orderId} {
        // Anyone who already has a specific order id (e.g. from the
        // order-status link) can fetch that one order. Only staff can
        // list/query the full orders collection — this stops a stranger
        // from browsing every table's orders for the cafe.
        allow get: if true;
        allow list: if isRestaurantAdmin(restaurantId);
        allow create: if true;
        allow delete: if isRestaurantAdmin(restaurantId);

        // What a customer (anyone holding the order's id) may change on
        // their own order — each path is limited to specific fields so
        // they can never touch prices, status flow, or other people's data:
        //  1. add more items while it's still pending/confirmed
        //  2. move it to a different table while it's still open
        //  3. cancel it, but only before the kitchen has started
        allow update: if isRestaurantAdmin(restaurantId)
          || (
            resource.data.status in ['pending', 'confirmed']
            && request.resource.data.status == resource.data.status
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['items', 'totalAmount', 'isUpdated', 'updatedAt'])
          )
          || (
            resource.data.status in ['pending', 'confirmed', 'preparing', 'ready']
            && request.resource.data.status == resource.data.status
            && request.resource.data.tableNumber is string
            && request.resource.data.tableNumber.size() > 0
            && request.resource.data.tableNumber.size() <= 20
            && request.resource.data.tableChangedBy == 'customer'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['tableNumber', 'previousTableNumber', 'tableChangedBy', 'tableChangedAt', 'updatedAt'])
          )
          || (
            resource.data.status in ['pending', 'confirmed']
            && request.resource.data.status == 'cancelled'
            && request.resource.data.cancelledBy == 'customer'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'cancelledBy', 'cancelledAt', 'updatedAt'])
          );
      }
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/admins/$(uid))
        && request.resource.data.keys().hasAll(['email', 'restaurantId'])
        && isRestaurantOwner(request.resource.data.restaurantId);
      allow update, delete: if false;
    }
  }
}
